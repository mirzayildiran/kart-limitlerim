{
  "name": "kart-limitlerim",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b",
    "lint": "eslint . && node scripts/check-css.mjs",
    "shots": "node scripts/shots.mjs",
    "ios:dev": "node scripts/ios-dev.mjs",
    "ios:build": "CAP_NATIVE=1 npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "@tesseract.js-data/tur": "^1.0.0",
    "idb": "^8.0.4",
    "preact": "^10.29.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "^1.64.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "description": "Kredi kartı ve KMH limitlerinden ne kadarını harcayabileceğini gösteren PWA bütçe uygulaması",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "private": true
}
